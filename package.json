{
  "name": "sales-kit",
  "version": "1.0.0",
  "description": "NexaFlow Sales Kit - Offline Desktop App",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "cd renderer && npm run dev",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "build": "npm run build:renderer && npm run build:java",
    "build:renderer": "cd renderer && npm run build",
    "build:java": "bash scripts/build-java.sh",
    "package": "npm run build && electron-builder",
    "download:jdk": "bash scripts/download-jdk.sh",
    "postinstall": "cd renderer && npm install"
  },
  "dependencies": {
    "electron-serve": "^1.3.0",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  }
}
