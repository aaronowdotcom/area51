{
  "name": "sales-kit",
  "version": "1.0.0",
  "description": "NexaFlow Sales Kit — pkg desktop launcher",
  "main": "launcher.js",
  "scripts": {
    "dev": "cd renderer && npm run dev",
    "build": "npm run build:renderer && npm run build:java",
    "build:renderer": "cd renderer && npm run build",
    "build:java": "bash scripts/build-java.sh",
    "package": "npm run build && bash scripts/package.sh",
    "download:jdk": "bash scripts/download-jdk.sh",
    "setup:win": "powershell -ExecutionPolicy Bypass -File scripts/setup-win.ps1",
    "postinstall": "cd renderer && npm install"
  },
  "pkg": {
    "scripts": ["launcher.js"],
    "targets": [
      "node20-linux-x64",
      "node20-macos-x64",
      "node20-macos-arm64"
    ],
    "outputPath": "pkg-out"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.11.5"
  }
}
